#!/usr/bin/env python
"""pre-commit 钩子（T15/P6；T29 改白名单 + 缺省拒绝）。

蓝图 §4 第 8 条（权限分离 v3）：研究、审查角色只能新增卡文件、修改策略库
与研究报告；引擎、关卡、成本、锁箱加载器、bt、风控与所有配置对其只读。
本钩子是 git 侧执行点，**白名单模式，缺省拒绝**（第四轮审核 M12：黑名单
有漏项——costs、research 包、mt5data、bt.py、钩子自身、CI 配置都没保住）。

角色（参数化）：
    环境变量 MT5QUANT_COMMIT_ROLE，或命令行 --role <role>（命令行优先）。
    admin    全放行（主会话/管理员）。
    research / review   走下方白名单。
    未指定 / 未知角色 → 拒绝一切暂存（fail-closed：宁可拦住管理员，也不
    默认放行）。管理员提交请设 MT5QUANT_COMMIT_ROLE=admin。

白名单（research/review；新增与修改用 git diff --cached --name-status 区分）：
    A     research/cards/*.toml                    新增卡（只放行状态 A——
          已提交的卡不得修改；版本迭代=同谱系新建 H###-v2.toml）
    A/M   src/mt5quant/strategies/library/**       策略库
    A/M   tests/test_strategies_*.py               策略测试
    A/M   docs/research/**                         研究报告
    其余路径与其余状态（D/R/C/T，含删除白名单文件、改名）一律拒绝；
    白名单之外没有例外——钩子自身、scripts/（bt.py 等）、CI（.github/）、
    src/mt5quant/costs/、src/mt5quant/research/、src/mt5data/、src/mt5live/、
    data/、config/、docs/p6/ 规则文件全部只读。

安装（入库但不自动安装；研究/审查角色不装也受 ACL 与台账约束）：
    printf '#!/bin/sh\nexec .venv/Scripts/python.exe \
scripts/hooks/pre-commit-readonly-paths "$@"\n' > .git/hooks/pre-commit

设计：可导入函数（check_paths（T38：CI 共用）/ check_staged /
violation_reason / parse_staged / resolve_role）+ 薄壳 main()，守护测试
tests/test_p6_docs.py 直接注入 (状态, 路径)，不依赖真实 git 状态；
CI 侧 .github/workflows/research-allowlist.yml 用 python -c 调
check_paths 对 research/** 分支 PR 执行同一规则（D25）。绕过
（git commit --no-verify）属违规操作，见规则文件。
"""
import os
import subprocess
import sys

ENV_ROLE = "MT5QUANT_COMMIT_ROLE"
ROLE_ADMIN = "admin"
WHITELIST_ROLES = frozenset({"research", "review"})

_CARD_DIR = "research/cards/"
_LIB_PREFIX = "src/mt5quant/strategies/library/"
_TEST_PREFIX = "tests/"
_DOC_PREFIX = "docs/research/"


def _norm(path: str) -> str:
    """统一按正斜杠比较（git 输出本就是正斜杠，测试注入可能是反斜杠）。"""
    return path.replace("\\", "/")


def _is_new_card(p: str) -> bool:
    """research/cards/ 下（不嵌套子目录）的 *.toml 卡文件。"""
    if not p.startswith(_CARD_DIR) or not p.endswith(".toml"):
        return False
    name = p[len(_CARD_DIR):]
    return bool(name) and "/" not in name


def _is_strategy_lib(p: str) -> bool:
    return p.startswith(_LIB_PREFIX)


def _is_strategy_test(p: str) -> bool:
    if not p.startswith(_TEST_PREFIX):
        return False
    name = p.rsplit("/", 1)[-1]
    return name.startswith("test_strategies_") and name.endswith(".py")


def _is_research_doc(p: str) -> bool:
    return p.startswith(_DOC_PREFIX)


def violation_reason(role: str | None, status: str, path: str) -> str | None:
    """单条暂存改动 (状态, 路径) 是否违反角色权限；违规返回原因，放行返回 None。

    status 取 git diff --name-status 状态码的首字母（A/M/D/R100→R 等）。
    """
    p = _norm(path)
    code = (status or "?")[0].upper()
    label = f"{path}（{code}）"
    if role == ROLE_ADMIN:
        return None
    if role not in WHITELIST_ROLES:
        who = f"未知角色 {role!r}" if role else "角色未指定"
        return (f"{label} -> {who}：缺省拒绝（admin 全放行；research/review "
                f"走白名单；用环境变量 {ENV_ROLE} 或 --role 指定）")
    if _is_new_card(p):
        if code == "A":
            return None
        return (f"{label} -> 卡文件只放行新增（A）：已提交的卡不得修改，"
                f"版本迭代=同谱系新建 H###-v2.toml")
    if _is_strategy_lib(p) or _is_strategy_test(p) or _is_research_doc(p):
        if code in ("A", "M"):
            return None
        return (f"{label} -> 白名单路径但状态 {code} 不允许（只放行 A/M；"
                f"删除/改名需管理员）")
    return (f"{label} -> 不在研究/审查白名单内（只允许：新增卡 "
            f"research/cards/*.toml、{_LIB_PREFIX}**、"
            f"tests/test_strategies_*.py、{_DOC_PREFIX}**）")


def check_staged(changes, role: str | None = None) -> list[str]:
    """对一批 (状态, 路径) 逐条检查，返回全部违规原因（空列表 = 放行）。"""
    return [m for m in (violation_reason(role, s, p) for s, p in changes)
            if m is not None]


def check_paths(status_path_pairs, role: str | None = None) -> list[str]:
    """T38/D25（H4）：CI 与本地钩子共用的同一份检查函数。

    与 check_staged 同一实现（同一规则、同一违规文案）。CI 侧
    .github/workflows/research-allowlist.yml 用 python -c 装载本文件并
    调用本函数，对 research/** 分支 PR 的 origin/main...HEAD diff 按研究
    角色规则硬性执行——本地钩子的角色取自环境变量（可自报 admin 绕过，
    第四轮审核 H4），CI 侧不可绕过。独立命名是为了让"改钩子"与"改 CI"
    都必然牵动这同一个符号，规则不会出现两份。
    """
    return check_staged(status_path_pairs, role)


def parse_staged(out: str) -> list[tuple[str, str]]:
    """解析 git diff --cached --name-status 输出：每行 "状态\\t路径[...]"，
    重命名/复制（R100/C75 两路）取新路径（最后一个字段）。"""
    changes: list[tuple[str, str]] = []
    for line in out.splitlines():
        fields = line.split("\t")
        if len(fields) >= 2 and fields[0].strip():
            changes.append((fields[0].strip(), fields[-1]))
    return changes


def staged_changes() -> list[tuple[str, str]]:
    """真实钩子路径：取暂存区 (状态, 路由)。不做 diff-filter——删除/重命名
    也必须经过白名单裁决，不能靠过滤器把它们藏掉。"""
    out = subprocess.run(
        ["git", "diff", "--cached", "--name-status"],
        capture_output=True, text=True, check=True).stdout
    return parse_staged(out)


def resolve_role(argv: list[str], env) -> tuple[str | None, list[str]]:
    """从 argv 提取 --role <role> / --role=<role>（命令行优先于环境变量
    ENV_ROLE）；返回 (role, 其余参数)。角色值去空白、小写。"""
    role = None
    paths: list[str] = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--role":
            if i + 1 >= len(argv):
                raise SystemExit(
                    "用法: pre-commit-readonly-paths "
                    "[--role admin|research|review] [路径...]")
            role = argv[i + 1]
            i += 2
        elif arg.startswith("--role="):
            role = arg.split("=", 1)[1]
            i += 1
        else:
            paths.append(arg)
            i += 1
    if role is None:
        role = env.get(ENV_ROLE)
    if isinstance(role, str):
        role = role.strip().lower() or None
    return role, paths


def main(argv=None, env=None) -> int:
    """薄壳：argv 为 ["--role", <role>, ...注入路径...]；注入路径可用
    "A\\tpath" 形式携带 git 状态，裸路径按 M（已存在文件的修改）处理。
    缺省现场取 git 暂存区；env 缺省 os.environ（测试注入用）。"""
    args = list(sys.argv[1:] if argv is None else argv)
    environ = os.environ if env is None else env
    role, paths = resolve_role(args, environ)
    if paths:
        changes = []
        for p in paths:
            if "\t" in p:
                status, path = p.split("\t", 1)
                changes.append((status, path))
            else:
                changes.append(("M", p))
    else:
        changes = staged_changes()
    violations = check_staged(changes, role)
    if not violations:
        return 0
    print(f"✗ pre-commit 拒绝（角色：{role or '未指定'}）："
          f"研究/审查角色按白名单放行，白名单之外一律只读")
    for v in violations:
        print(f"  - {v}")
    print("  白名单：新增卡 research/cards/*.toml（仅状态 A）、"
          "src/mt5quant/strategies/library/**、")
    print("  tests/test_strategies_*.py、docs/research/**（后三类仅 A/M）。")
    print(f"  管理员提交设 {ENV_ROLE}=admin 或传 --role admin；")
    print("  发现 bug 请写进研究报告交主会话，不要 --no-verify 绕过。")
    return 1


if __name__ == "__main__":
    sys.exit(main())
