#!/usr/bin/env python
"""pre-commit 钩子（T15/P6）：研究/审查角色不得触碰禁改路径。

蓝图 §4 第 8 条（权限分离）：研究 agent 不能改引擎、关卡、风控与门槛
配置。本钩子是 git 侧的执行点：暂存区里出现下列路径的改动 → 拒绝提交。

禁改清单（与 docs/p6/research-agent.md、docs/p6/permissions.md 保持一致）：
- src/mt5quant/backtest/     回测引擎（A/B 层、报告、截断测试）
- src/mt5quant/validation/   验证关卡 G0–G5 与冻结指纹 FROZEN_GATES_SHA256
- src/mt5live/               实盘链路与风控
- config/gates.toml          关卡门槛（另有 sha256 冻结核对兜底）
- 任意位置的 engine_*.py     未来新增的引擎层自动受保护

安装（入库但不自动安装；研究/审查角色不装也受 ACL 与台账约束）：
    printf '#!/bin/sh\nexec .venv/Scripts/python.exe \
scripts/hooks/pre-commit-readonly-paths "$@"\n' > .git/hooks/pre-commit

设计：可导入函数（check_staged / forbidden_reason）+ 薄壳 main()，
守护测试 tests/test_p6_docs.py 直接注入暂存路径，不依赖真实 git 状态。
绕过（git commit --no-verify）属违规操作，见规则文件。
"""
import subprocess
import sys

# (路径前缀, 是什么) —— 目录以 / 结尾；统一按正斜杠比较
READONLY_PREFIXES = (
    ("src/mt5quant/backtest/", "回测引擎"),
    ("src/mt5quant/validation/", "验证关卡"),
    ("src/mt5live/", "实盘与风控"),
    ("config/gates.toml", "关卡门槛配置"),
)


def forbidden_reason(path: str) -> str | None:
    """单个暂存路径是否触碰禁改清单；命中返回原因文案，未命中返回 None。

    路径统一成正斜杠再比较（git 输出本就是正斜杠，测试注入可能是反斜杠）。
    engine_*.py 按文件名匹配任意目录（engine_c.py 等未来实现同样受保护）。
    """
    p = path.replace("\\", "/")
    for prefix, what in READONLY_PREFIXES:
        if p == prefix.rstrip("/") or p.startswith(prefix):
            return f"{path} -> {what}（{prefix}）对研究/审查角色只读"
    name = p.rsplit("/", 1)[-1]
    if name.startswith("engine_") and name.endswith(".py"):
        return f"{path} -> 引擎文件 engine_*.py 对研究/审查角色只读"
    return None


def check_staged(paths) -> list[str]:
    """对一批暂存路径逐条检查，返回全部违规原因（空列表 = 放行）。"""
    return [msg for msg in map(forbidden_reason, paths) if msg is not None]


def staged_files() -> list[str]:
    """真实钩子路径：取暂存区改动的文件名（新增/复制/修改/重命名）。"""
    out = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMRT"],
        capture_output=True, text=True, check=True).stdout
    return [line for line in out.splitlines() if line.strip()]


def main(argv=None) -> int:
    """薄壳：argv 为已暂存路径（测试注入）；缺省现场取 git 暂存区。"""
    paths = list(argv) if argv else staged_files()
    violations = check_staged(paths)
    if not violations:
        return 0
    print("✗ pre-commit 拒绝：以下只读路径不允许研究/审查角色修改")
    for v in violations:
        print(f"  - {v}")
    print("  引擎/关卡/风控/门槛的改动只能由主会话（人）提交；")
    print("  发现 bug 请写进研究报告交主会话，不要 --no-verify 绕过。")
    return 1


if __name__ == "__main__":
    sys.exit(main())
